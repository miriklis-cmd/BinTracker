<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
    <AnalysisLevelSecurity>latest</AnalysisLevelSecurity>
    <AnalysisModeSecurity>Recommended</AnalysisModeSecurity>

    <!--
      Single source of truth for the BinTracker release version.
      Update this value once per release; the application, build script,
      assemblies and future packaging all derive their version from here.
    -->
    <Version>0.5.0-alpha.21</Version>
    <AssemblyVersion>0.5.0.0</AssemblyVersion>
    <FileVersion>0.5.0.0</FileVersion>
    <InformationalVersion>0.5.0-alpha.21</InformationalVersion>
  </PropertyGroup>
</Project>
