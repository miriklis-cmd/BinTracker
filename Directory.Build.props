<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      Single source of truth for the BinTracker release version.
      Update this value once per release; the application, build script,
      assemblies and future packaging all derive their version from here.
    -->
    <Version>0.4.0-alpha.19.11.3</Version>
    <AssemblyVersion>0.4.0.0</AssemblyVersion>
    <FileVersion>0.4.0.0</FileVersion>
    <InformationalVersion>0.4.0-alpha.19.11.3</InformationalVersion>
  </PropertyGroup>
</Project>
